{
  "name": "pnq-matching",
  "version": "0.1.0",
  "private": true,
  "description": "PNQ Sound Matching - static, client-only mobile test prototype app built on the PNQ Health Design System.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint-tokens.mjs",
